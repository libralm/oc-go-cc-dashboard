var alertSent = {};
function checkAlerts(metrics, circuits) {
  var keys = Object.keys(circuits);
  for (var i=0;i<keys.length;i++) {
    var k = keys[i];
    if (circuits[k] === 'open' && !alertSent[k]) {
      showAlert('熔断器打开', '模型 '+k+' 已熔断，将自动切换到备用模型。');
      alertSent[k] = true;
    }
    if (circuits[k] === 'closed') alertSent[k] = false;
  }
  var errRate = metrics.requests_received > 0 ? metrics.requests_failed / metrics.requests_received : 0;
  if (errRate > 0.5 && metrics.requests_received > 5 && !alertSent['_high_err']) {
    showAlert('高错误率', '错误率超过 50% ('+metrics.requests_failed+'/'+metrics.requests_received+')，请检查代理状态。');
    alertSent['_high_err'] = true;
  }
  if (errRate <= 0.5) alertSent['_high_err'] = false;
}

