# ── BACKEND ──

class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        pass

    def json(self, code, data):
        body = json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def html_page(self, code, html):
        body = html.encode()
        self.send_response(code)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = urlparse(self.path).path
        q = parse_qs(urlparse(self.path).query)
        if p == "/" or p == "/index.html":
            self.html_page(200, HTML)
        elif p == "/api/health":
            self.json(200, proxy_health())
        elif p == "/api/timeline":
            n = int(q.get("n", [30])[0])
            self.json(200, parse_timeline(n))
        elif p == "/api/config":
            try:
                with open(CONFIG_PATH) as f:
                    config = json.load(f)
            except Exception:
                config = {"models": {}}
            self.json(200, {"config": config, "models": get_models()})
        elif p == "/api/logs":
            self.json(200, {"logs": read_logs()})
        elif p == "/api/presets":
            self.json(200, list_presets())
        elif p == "/api/keys":
            data = load_keys()
            # Mask keys for security
            masked = {"keys": [], "active_index": data["active_index"]}
            for k in data["keys"]:
                mk = dict(k)
                full = mk.get("key", "")
                if len(full) > 16:
                    mk["key"] = full[:10] + "..." + full[-6:]
                masked["keys"].append(mk)
            self.json(200, masked)
        else:
            self.send_response(404)
            self.end_headers()

    def do_POST(self):
        p = urlparse(self.path).path
        q = parse_qs(urlparse(self.path).query)
        if p == "/api/save":
            self.handle_save()
        elif p == "/api/test":
            self.handle_test()
        elif p == "/api/reset-circuit":
            self.handle_reset()
        elif p == "/api/presets":
            self.handle_save_preset()
        elif p == "/api/presets/load":
            name = q.get("name", [""])[0]
            self.handle_load_preset(name)
        elif p == "/api/keys":
            self.handle_add_key()
        elif p == "/api/keys/activate":
            idx = int(q.get("index", [0])[0])
            self.handle_activate_key(idx)
        else:
            self.send_response(404)
            self.end_headers()

    def do_DELETE(self):
        p = urlparse(self.path).path
        q = parse_qs(urlparse(self.path).query)
        if p == "/api/presets":
            name = q.get("name", [""])[0]
            self.handle_delete_preset(name)
        elif p == "/api/keys":
            idx = int(q.get("index", [0])[0])
            self.handle_delete_key(idx)
        else:
            self.send_response(404)
            self.end_headers()

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def read_body(self):
        length = int(self.headers.get("Content-Length", 0))
        if length:
            return json.loads(self.rfile.read(length))
        return {}

    def handle_save(self):
        try:
            data = self.read_body()
            with open(CONFIG_PATH) as f:
                config = json.load(f)
            if "models" in data:
                for scenario, cfg in data["models"].items():
                    if scenario in config.get("models", {}):
                        config["models"][scenario]["model_id"] = cfg.get(
                            "model_id", config["models"][scenario]["model_id"]
                        )
            with open(CONFIG_PATH, "w") as f:
                json.dump(config, f, indent=2)
            restart_proxy()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_test(self):
        try:
            import urllib.request
            data = json.dumps({
                "model": "claude-sonnet-4-20250514",
                "max_tokens": 5,
                "messages": [{"role": "user", "content": "hi"}]
            }).encode()
            req = urllib.request.Request(PROXY_URL, data=data)
            req.add_header("Content-Type", "application/json")
            req.add_header("x-api-key", "unused")
            req.add_header("anthropic-version", "2023-06-01")
            t0 = time.time()
            resp = urllib.request.urlopen(req, timeout=15)
            result = json.loads(resp.read())
            latency = f"{(time.time()-t0)*1000:.0f}ms"
            model = result.get("model", "unknown")
            self.json(200, {"ok": True, "latency": latency, "model": model})
        except Exception as e:
            self.json(200, {"ok": False, "error": str(e)[:100]})

    def handle_reset(self):
        try:
            restart_proxy()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_save_preset(self):
        try:
            data = self.read_body()
            name = data.get("name", "").strip()
            if not name:
                self.json(400, {"ok": False, "error": "名称不能为空"})
                return
            # Read current config
            with open(CONFIG_PATH) as f:
                config = json.load(f)
            # Sanitize name for filename
            safe = re.sub(r"[^\w\-]", "_", name)
            path = PRESETS_DIR / f"{safe}.json"
            with open(path, "w") as f:
                json.dump(config, f, indent=2)
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_load_preset(self, name):
        try:
            safe = re.sub(r"[^\w\-]", "_", name)
            path = PRESETS_DIR / f"{safe}.json"
            if not path.exists():
                self.json(404, {"ok": False, "error": "预设不存在"})
                return
            with open(path) as f:
                config = json.load(f)
            # Preserve API key from current config
            try:
                with open(CONFIG_PATH) as f:
                    cur = json.load(f)
                config["api_key"] = cur.get("api_key", config.get("api_key", ""))
            except Exception:
                pass
            with open(CONFIG_PATH, "w") as f:
                json.dump(config, f, indent=2)
            restart_proxy()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_delete_preset(self, name):
        try:
            safe = re.sub(r"[^\w\-]", "_", name)
            path = PRESETS_DIR / f"{safe}.json"
            if not path.exists():
                self.json(404, {"ok": False, "error": "预设不存在"})
                return
            path.unlink()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_add_key(self):
        try:
            data = self.read_body()
            key = data.get("key", "").strip()
            if not key:
                self.json(400, {"ok": False, "error": "Key 不能为空"})
                return
            label = data.get("label", "").strip() or None
            keys_info = load_keys()
            # Check for duplicates
            for k in keys_info["keys"]:
                if k["key"] == key:
                    self.json(400, {"ok": False, "error": "Key 已存在"})
                    return
            keys_info["keys"].append({"key": key, "label": label, "exhausted": False})
            # If this is the first key, activate it
            if keys_info["active_index"] < 0 and len(keys_info["keys"]) == 1:
                keys_info["active_index"] = 0
                _write_active_key(key)
            save_keys(keys_info)
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_activate_key(self, idx):
        try:
            keys_info = load_keys()
            if idx < 0 or idx >= len(keys_info["keys"]):
                self.json(400, {"ok": False, "error": "索引无效"})
                return
            if keys_info["keys"][idx].get("exhausted"):
                self.json(400, {"ok": False, "error": "该 Key 已耗尽，无法激活"})
                return
            keys_info["active_index"] = idx
            _write_active_key(keys_info["keys"][idx]["key"])
            save_keys(keys_info)
            restart_proxy()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})

    def handle_delete_key(self, idx):
        try:
            keys_info = load_keys()
            if idx < 0 or idx >= len(keys_info["keys"]):
                self.json(400, {"ok": False, "error": "索引无效"})
                return
            removed = keys_info["keys"].pop(idx)
            # Adjust active_index
            if keys_info["active_index"] == idx:
                # Find next non-exhausted key
                nxt = _find_next_key(keys_info)
                keys_info["active_index"] = nxt if nxt >= 0 else -1
                if nxt >= 0:
                    _write_active_key(keys_info["keys"][nxt]["key"])
                else:
                    _write_active_key("${OC_GO_CC_API_KEY}")
            elif keys_info["active_index"] > idx:
                keys_info["active_index"] -= 1
            save_keys(keys_info)
            if keys_info["active_index"] >= 0:
                restart_proxy()
            self.json(200, {"ok": True})
        except Exception as e:
            self.json(500, {"ok": False, "error": str(e)})


