<script>
var REFRESH_INTERVAL = 5000;
var refreshTimer = null;
var refreshPaused = false;
var prevMetrics = {};
var latencyHistory = [];
var logFilterType = 'all';
var logAutoFollow = true;
var currentConfig = {};
var availableModels = [];
var currentPreset = '';

function $(id) { return document.getElementById(id); }

function toast(msg, cls) {
  var t = document.createElement('div');
  t.className = 'toast toast-' + (cls || 'info');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(function(){ t.remove(); }, 2500);
}

// ── Data fetching ──
async function fetchAll() {
  try {
    var r1 = await fetch('/api/health'); var health = r1.ok ? await r1.json() : null;
    var r2 = await fetch('/api/timeline?n=30'); var tl = r2.ok ? await r2.json() : [];
    var r3 = await fetch('/api/config'); var cfg = r3.ok ? await r3.json() : {};
    var r4 = await fetch('/api/logs'); var logs = r4.ok ? await r4.json() : {};
    var r5 = await fetch('/api/presets'); var presets = r5.ok ? await r5.json() : [];
    var r6 = await fetch('/api/keys'); var keysResp = r6.ok ? await r6.json() : {};

    if (health) {
      renderHeader(health);
      renderMetrics(health.metrics || {});
      renderCircuits(health.circuit_breakers || {});
      renderUsage(health.models || {});
      // Quick stats in usage card
      var totalReq = health.metrics?.requests_received || 0;
      var totalSuccess = health.metrics?.requests_success || 0;
      var models = health.models || {};
      var modelList = Object.keys(models).map(function(m){return m+':'+models[m];}).join(', ');
      $('usage-quick').textContent = '总请求 '+totalReq+' / 成功 '+totalSuccess+' | '+ (modelList || '暂无');
    }
    renderTimeline(tl || []);
    renderLatencyTrend();
    if (cfg.config) { currentConfig = cfg.config; availableModels = cfg.models; renderConfigRows(); }
    if (logs.logs !== undefined) { window._logs = logs.logs; renderLogs(); }
    renderPresets(presets || []);
    renderKeys(keysResp.keys || [], keysResp.active_index);
    checkAlerts(health ? health.metrics || {} : {}, health ? health.circuit_breakers || {} : {});
    $('footer-time').textContent = new Date().toLocaleTimeString('zh-CN');
  } catch(e) { console.error(e); }
}

// ── Header ──
function renderHeader(health) {
  var el = $('hdr-status');
  if (health.status === 'ok') {
    el.innerHTML = '<span class="dot dot-green"></span>运行中 (PID ' + (health._pid || '--') + ')';
  } else {
    el.innerHTML = '<span class="dot dot-red"></span>异常';
  }
}

// ── Metrics ──
function renderMetrics(m) {
  var now = m;
  var prev = prevMetrics || {};
  var items = [
    { key:'requests_received', label:'总请求', fmt:function(v){return v;} },
    { key:'requests_success', label:'成功', fmt:function(v){return v + ' <span style="font-size:11px;color:var(--text2)">' + (now.requests_received>0?Math.round(v/now.requests_received*100)+'%':'-') + '</span>';} },
    { key:'requests_failed', label:'失败', fmt:function(v){return v;} },
    { key:'p95_latency_ms', label:'P95延迟', fmt:function(v){return (v/1000).toFixed(1)+'s';} },
    { key:'p99_latency_ms', label:'P99延迟', fmt:function(v){return (v/1000).toFixed(1)+'s';} },
    { key:'requests_streamed', label:'流式请求', fmt:function(v){return v + ' / ' + (now.upstream_calls||0) + ' 上游';} }
  ];
  var html = '';
  for (var i=0;i<items.length;i++) {
    var it = items[i];
    var val = now[it.key] || 0;
    var diff = '';
    if (prev[it.key] !== undefined) {
      var d = val - prev[it.key];
      if (d > 0) diff = ' <span class="trend-up">+'+d+'</span>';
      else if (d < 0) diff = ' <span class="trend-down">'+d+'</span>';
      else diff = ' <span class="trend-flat">→</span>';
    }
    html += '<div class="metric-card"><div class="value">'+it.fmt(val)+'</div><div class="label">'+it.label+'</div><div class="trend">'+diff+'</div></div>';
  }
  $('metrics-row').innerHTML = html;
  prevMetrics = JSON.parse(JSON.stringify(now));
}

// ── Circuits ──
var lastCircuitState = {};
function renderCircuits(cb) {
  var html = '';
  var keys = Object.keys(cb);
  var healthy = 0;
  for (var i=0;i<keys.length;i++) {
    var k = keys[i];
    var st = cb[k];
    var cls = st === 'closed' ? 'state-closed' : st === 'open' ? 'state-open' : 'state-half';
    var txt = st === 'closed' ? '正常' : st === 'open' ? '熔断' : '半开';
    var dotCls = st === 'closed' ? 'dot-green' : st === 'open' ? 'dot-red' : 'dot-yellow';
    if (st === 'closed') healthy++;
    html += '<div class="circuit-row"><span class="dot '+dotCls+'"></span><span class="name">'+k+'</span><span class="state '+cls+'">'+txt+'</span></div>';
  }
  if (!keys.length) html = '<div style="font-size:12px;color:var(--text2);padding:8px 0">无熔断器数据</div>';
  $('circuits').innerHTML = html;
  $('circuit-health').textContent = keys.length ? Math.round(healthy/keys.length*100)+'% 健康' : '--';

  // Check for new circuit trip alerts
  for (var i=0;i<keys.length;i++) {
    var k = keys[i];
    var st = cb[k];
    if (lastCircuitState[k] === 'closed' && st === 'open') {
      showAlert('熔断器打开', '模型 ' + k + ' 已熔断，将自动切换到备用模型。');
    }
  }
  lastCircuitState = JSON.parse(JSON.stringify(cb));
}

// ── Model usage bars ──
function renderUsage(models) {
  var html = '';
  var keys = Object.keys(models);
  var maxv = 0;
  for (var i=0;i<keys.length;i++) { if (models[keys[i]] > maxv) maxv = models[keys[i]]; }
  if (!keys.length) { $('usage-chart').innerHTML = '<div style="font-size:12px;color:var(--text2)">暂无数据</div>'; return; }
  var colors = ['#58a6ff','#3fb950','#d29922','#a371f7','#f85149','#79c0ff','#56d364','#e3b341'];
  for (var i=0;i<keys.length;i++) {
    var model = keys[i];
    var count = models[model];
    var pct = maxv > 0 ? Math.round(count/maxv*100) : 0;
    html += '<div class="usage-bar-wrap"><span class="label">'+model+'</span><div class="bar-bg"><div class="bar-fill" style="width:'+pct+'%;background:'+(colors[i%colors.length])+'"></div></div><span class="count">'+count+'次</span></div>';
  }
  $('usage-chart').innerHTML = html;
}

// ── Timeline ──
function renderTimeline(items) {
  $('timeline-count').textContent = items.length;
  var html = '';
  for (var i=0;i<items.length;i++) {
    var it = items[i];
    var statusIcon = it.status === 'success' ? '<span class="status-ok">&#9679;</span>' :
                     it.status === 'error' ? '<span class="status-err">&#9679;</span>' :
                     '<span class="status-warn">&#9679;</span>';
    var timeStr = it.time ? it.time.substring(11,19) : '--:--:--';
    html += '<div class="timeline-item"><span class="timeline-time">'+timeStr+'</span>'+statusIcon+'<span class="timeline-model">'+it.model+'</span><span style="font-size:10px;color:var(--text3)">'+(it.scenario||'')+'</span><span class="timeline-latency">'+(it.latency||'--')+'</span></div>';
  }
  if (!items.length) html = '<div style="font-size:12px;color:var(--text2);padding:12px">暂无请求记录</div>';
  $('timeline').innerHTML = html;
}

// ── Latency trend canvas ──
function renderLatencyTrend() {
  var canvas = $('latency-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var dpr = window.devicePixelRatio || 1;
  var rect = canvas.getBoundingClientRect();
  var w = rect.width * dpr;
  var h = 160 * dpr;
  canvas.width = w; canvas.height = h;
  var data = latencyHistory.slice(-60);
  if (!data.length) { ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--text2'); ctx.font='12px sans-serif'; ctx.fillText('暂无延迟数据',20,50); return; }
  var maxv = Math.max.apply(null, data) || 1;
  var p95 = percentile(data, 95);
  var pad = 8*dpr;
  var pw = w - pad*2, ph = h - pad*2;
  // Grid lines
  ctx.strokeStyle = getComputedStyle(document.body).getPropertyValue('--border');
  ctx.lineWidth = 0.5 * dpr;
  for (var g=0;g<3;g++) {
    var gy = pad + ph * (g/3);
    ctx.beginPath(); ctx.moveTo(pad,gy); ctx.lineTo(w-pad,gy); ctx.stroke();
  }
  // P95 line
  var p95y = pad + ph * (1 - p95/maxv);
  ctx.strokeStyle = getComputedStyle(document.body).getPropertyValue('--red');
  ctx.setLineDash([3*dpr,3*dpr]);
  ctx.lineWidth = 1*dpr;
  ctx.beginPath(); ctx.moveTo(pad,p95y); ctx.lineTo(w-pad,p95y); ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--red');
  ctx.font = (9*dpr)+'px sans-serif';
  ctx.fillText('P95='+(p95/1000).toFixed(1)+'s', pad, p95y-2*dpr);
  // Line
  if (data.length > 1) {
    var stepX = pw / (data.length-1);
    ctx.strokeStyle = getComputedStyle(document.body).getPropertyValue('--accent');
    ctx.lineWidth = 1.5*dpr;
    ctx.beginPath();
    for (var i=0;i<data.length;i++) {
      var x = pad + i*stepX;
      var y = pad + ph * (1 - data[i]/maxv);
      if (i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);
    }
    ctx.stroke();
    // Dot on last
    ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--accent');
    ctx.beginPath();
    ctx.arc(pad+(data.length-1)*stepX, pad+ph*(1-data[data.length-1]/maxv), 3*dpr, 0, Math.PI*2);
    ctx.fill();
  }
  // Labels
  ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--text3');
  ctx.font = (9*dpr)+'px sans-serif';
  ctx.fillText((maxv/1000).toFixed(1)+'s', w-pad-20*dpr, pad+10*dpr);
  ctx.fillText('0', pad, h-pad-2*dpr);
}

function percentile(arr, p) {
  if (!arr.length) return 0;
  var sorted = arr.slice().sort(function(a,b){return a-b;});
  var idx = (p/100) * (sorted.length-1);
  var lo = Math.floor(idx), hi = Math.ceil(idx);
  if (lo === hi) return sorted[lo];
  return sorted[lo] + (sorted[hi]-sorted[lo])*(idx-lo);
}

