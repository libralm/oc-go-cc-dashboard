# ── Key management helpers ──

def load_keys():
    """Load keys from keys.json. Returns {keys: [...], active_index: int}."""
    default = {"keys": [], "active_index": -1}
    try:
        if KEYS_PATH.exists():
            data = json.loads(KEYS_PATH.read_text())
            # Migrate: ensure exhausted field exists
            for k in data.get("keys", []):
                if "exhausted" not in k:
                    k["exhausted"] = False
            return data
    except Exception:
        pass
    # Try migrating from current config's api_key
    try:
        if CONFIG_PATH.exists():
            cfg = json.loads(CONFIG_PATH.read_text())
            api_key = cfg.get("api_key", "")
            if api_key and api_key != "${OC_GO_CC_API_KEY}" and api_key.startswith("sk-"):
                default = {"keys": [{"key": api_key, "label": "默认 Key", "exhausted": False}], "active_index": 0}
                save_keys(default)
    except Exception:
        pass
    return default


def save_keys(data):
    """Save keys to keys.json."""
    KEYS_PATH.parent.mkdir(parents=True, exist_ok=True)
    KEYS_PATH.write_text(json.dumps(data, indent=2))


def _write_active_key(key):
    """Write the active API key into config.json."""
    try:
        with open(CONFIG_PATH) as f:
            config = json.load(f)
        config["api_key"] = key
        with open(CONFIG_PATH, "w") as f:
            json.dump(config, f, indent=2)
    except Exception:
        pass


def _find_next_key(keys_info):
    """Find next non-exhausted key index, or -1."""
    for i, k in enumerate(keys_info["keys"]):
        if not k.get("exhausted", False) and i != keys_info["active_index"]:
            return i
    # If none found, return any non-exhausted
    for i, k in enumerate(keys_info["keys"]):
        if not k.get("exhausted", False):
            return i
    return -1


def check_key_exhaustion(log_text):
    """Check recent log for quota-exhausted errors. Returns True if key was rotated."""
    global _quota_fail_count
    # Look for 429 / insufficient_quota / billing in last few lines
    lines = log_text.strip().split("\n")[-20:]
    found = False
    for line in lines:
        if re.search(r"(429|insufficient_quota|exceeded your current quota|InsufficientQuota|billing)", line, re.I):
            found = True
            break
    if not found:
        _quota_fail_count = 0
        return False
    _quota_fail_count += 1
    # Require 3 consecutive fails before switching
    if _quota_fail_count < 3:
        return False
    _quota_fail_count = 0
    # Rotate key
    with _key_rotate_lock:
        keys_info = load_keys()
        active = keys_info["active_index"]
        if active >= 0 and active < len(keys_info["keys"]):
            keys_info["keys"][active]["exhausted"] = True
        nxt = _find_next_key(keys_info)
        if nxt >= 0 and nxt != active:
            keys_info["active_index"] = nxt
            _write_active_key(keys_info["keys"][nxt]["key"])
            save_keys(keys_info)
            restart_proxy()
            return True
        save_keys(keys_info)
    return False


def monitor_logs():
    """Background thread: periodically check logs for quota exhaustion."""
    global _last_log_size
    while True:
        time.sleep(15)
        try:
            if LOG_PATH.exists():
                text = LOG_PATH.read_text()
                if text:
                    check_key_exhaustion(text[-5000:])
        except Exception:
            pass


def watchdog_loop():
    """Background thread: monitor proxy health and restart if dead."""
    consecutive = 0
    while True:
        time.sleep(30)
        try:
            import urllib.request
            req = urllib.request.Request(HEALTH_URL)
            resp = urllib.request.urlopen(req, timeout=5)
            data = json.loads(resp.read())
            if data.get("status") == "ok":
                consecutive = 0
                continue
        except Exception:
            pass
        consecutive += 1
        if consecutive >= 3:
            try:
                restart_proxy()
                consecutive = 0
            except Exception:
                pass


# ── Daemonize ──

def daemonize():
    pid = os.fork()
    if pid > 0:
        sys.exit(0)
    os.setsid()
    pid = os.fork()
    if pid > 0:
        sys.exit(0)
    os.chdir("/")
    os.umask(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    os.dup2(devnull, 0)
    os.dup2(devnull, 1)
    os.dup2(devnull, 2)
    os.close(devnull)


# ── Main ──

def main():
    global START_TIME
    import argparse
    parser = argparse.ArgumentParser(description="oc-go-cc Web Dashboard v2")
    parser.add_argument("--port", type=int, default=3457)
    parser.add_argument("-b", "--background", action="store_true")
    parser.add_argument("--stop", action="store_true")
    args = parser.parse_args()

    if args.stop:
        if PID_FILE.exists():
            try:
                pid = int(PID_FILE.read_text().strip())
                os.kill(pid, signal.SIGTERM)
                PID_FILE.unlink()
                print("Dashboard stopped.")
            except Exception as e:
                print(f"Failed: {e}")
        else:
            print("Not running.")
        sys.exit(0)

    if args.background:
        daemonize()

    server = HTTPServer((HOST, args.port), Handler)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))
    # Start background threads
    monitor_thread = threading.Thread(target=monitor_logs, daemon=True)
    monitor_thread.start()
    watchdog_thread = threading.Thread(target=watchdog_loop, daemon=True)
    watchdog_thread.start()
    if not args.background:
        print(f"oc-go-cc Dashboard v2 → http://{HOST}:{args.port}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down...")
        server.server_close()
        PID_FILE.unlink(missing_ok=True)


if __name__ == "__main__":
    main()

