function renderLogs() {
  var raw = window._logs || '';
  var filter = ($('log-filter').value || '').toLowerCase();
  var lines = raw.split('\n');
  var html = '';
  for (var i=0;i<lines.length;i++) {
    var line = lines[i];
    if (!line) continue;
    var cls = 'hl-dim';
    if (/ERROR|error|level=ERROR/.test(line)) cls = 'hl-err';
    else if (/WARN|level=WARN/.test(line)) cls = 'hl-warn';
    else if (/completed|succeeded/.test(line)) cls = 'hl-ok';

    if (logFilterType === 'err' && cls !== 'hl-err') continue;
    if (logFilterType === 'warn' && cls !== 'hl-warn') continue;
    if (logFilterType === 'ok' && cls !== 'hl-ok') continue;
    if (filter && line.toLowerCase().indexOf(filter) === -1) continue;

    html += '<span class="'+cls+'">'+escHtml(line)+'</span>\n';
  }
  $('logs').innerHTML = html || '无匹配日志';
  if (logAutoFollow) { var el=$('logs'); setTimeout(function(){el.scrollTop=el.scrollHeight;},50); }
}

