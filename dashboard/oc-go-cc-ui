def proxy_health():
    """Get health from proxy + PID from status."""
    result = {"status": "unknown", "circuit_breakers": {}, "metrics": {}, "models": {}, "_pid": None}
    try:
        import urllib.request
        req = urllib.request.Request(HEALTH_URL)
        resp = urllib.request.urlopen(req, timeout=3)
        data = json.loads(resp.read())
        result.update(data)
    except Exception:
        result["status"] = "offline"
    # Get PID
    try:
        env = os.environ.copy()
        out = subprocess.run([str(BINARY), "status"], capture_output=True, text=True, timeout=5, env=env)
        for line in out.stdout.split("\n"):
            if "PID" in line:
                result["_pid"] = line.split()[-1].strip().rstrip(")")
                break
    except Exception:
        pass
    return result


def parse_timeline(n=30):
    """Parse log file to build a request timeline."""
    items = []
    try:
        text = LOG_PATH.read_text()
        lines = text.strip().split("\n")
        for line in reversed(lines):
            if len(items) >= n:
                break
            # Extract timestamp and everything after "msg="
            match = re.search(r"time=([\d\-T:.+\-]+)\s+level=\w+\s+", line)
            if not match:
                continue
            timestamp = match.group(1)
            rest = line[match.end():]

            if "request completed" in rest:
                m_model = re.search(r"model=(\S+)", rest)
                m_lat = re.search(r"latency=([\d.]+)s", rest)
                items.append({
                    "time": timestamp, "status": "success",
                    "model": m_model.group(1) if m_model else "unknown",
                    "scenario": "", "latency": m_lat.group(1)+"s" if m_lat else "--",
                    "latency_ms": int(float(m_lat.group(1))*1000) if m_lat else 0
                })
            elif "request error" in rest:
                m_status = re.search(r"status=(\d+)", rest)
                items.append({
                    "time": timestamp, "status": "error",
                    "model": "system", "scenario": "",
                    "latency": m_status.group(1) if m_status else "err", "latency_ms": 0
                })
            elif "model failed" in rest and "trying fallback" in rest:
                m_model = re.search(r"model=(\S+)", rest)
                items.append({
                    "time": timestamp, "status": "error",
                    "model": m_model.group(1) if m_model else "unknown",
                    "scenario": "fallback", "latency": "err", "latency_ms": 0
                })
    except Exception:
        pass
    return items


def get_models():
    """Get available model IDs."""
    try:
        env = os.environ.copy()
        result = subprocess.run(
            [str(BINARY), "models"], capture_output=True, text=True, timeout=10, env=env
        )
        models = []
        for line in result.stdout.split("\n"):
            line = line.strip()
            if line and not line.startswith("─") and not line.startswith("Model") \
               and not line.startswith("Available") and not line.startswith("Use these"):
                parts = line.split()
                if parts and not parts[0].startswith("─"):
                    models.append(parts[0])
        return models if models else [
            "deepseek-v4-pro", "deepseek-v4-flash", "kimi-k2.6",
            "kimi-k2.5", "glm-5.1", "glm-5", "qwen3.6-plus"
        ]
    except Exception:
        return ["deepseek-v4-pro", "deepseek-v4-flash", "kimi-k2.6"]


def read_logs():
